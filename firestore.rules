rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // ملف المستخدم قد لا يكون موجوداً بعد أثناء التسجيل، فالتحقق من الوجود
    // ضروري قبل قراءته وإلا فشل تقييم القاعدة.
    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(role) {
      return profileExists() && userDoc().get('role', '') == role;
    }
    function isAdmin() {
      return hasRole('admin');
    }
    // غياب adminLevel أو أي قيمة غير 'admin' = سوبر (مطابق لـ adminLevel.ts).
    function isSuperAdmin() {
      return isAdmin() && userDoc().get('adminLevel', '') != 'admin';
    }
    function adminPerm(key) {
      return userDoc().get('adminPermissions', {}).get(key, 'none');
    }
    function adminCanRead(key) {
      return isSuperAdmin()
        || (isAdmin() && adminPerm(key) in ['read', 'write']);
    }
    function adminCanWrite(key) {
      return isSuperAdmin()
        || (isAdmin() && adminPerm(key) == 'write');
    }
    // قراءة/كتابة users حسب دور المستند وصلاحية القسم.
    function adminCanReadUserDoc() {
      return isSuperAdmin()
        || (adminCanRead('users') && resource.data.role == 'admin')
        || (adminCanRead('customers') && resource.data.role == 'customer')
        || (adminCanRead('technicians') && resource.data.role == 'technician')
        || (adminCanRead('workshops')
          && resource.data.role in ['workshop', 'oilWorkshop', 'paintShop']);
    }
    function adminCanWriteUserDoc() {
      return isSuperAdmin()
        || (adminCanWrite('users') && resource.data.role == 'admin')
        || (adminCanWrite('customers') && resource.data.role == 'customer')
        || (adminCanWrite('technicians') && resource.data.role == 'technician')
        || (adminCanWrite('workshops')
          && resource.data.role in ['workshop', 'oilWorkshop', 'paintShop']);
    }
    function adminCanCreateUserDoc() {
      return isSuperAdmin()
        || (adminCanWrite('users') && request.resource.data.role == 'admin')
        || (adminCanWrite('customers') && request.resource.data.role == 'customer')
        || (adminCanWrite('technicians') && request.resource.data.role == 'technician')
        || (adminCanWrite('workshops')
          && request.resource.data.role in ['workshop', 'oilWorkshop', 'paintShop']);
    }
    function isTechnicianRole() {
      return hasRole('technician');
    }
    function isWorkshopRole() {
      return hasRole('workshop');
    }
    function isOilWorkshopRole() {
      return hasRole('oilWorkshop');
    }
    function isPaintShopRole() {
      return hasRole('paintShop');
    }
    function isProviderRole() {
      return isTechnicianRole() || isWorkshopRole() || isOilWorkshopRole() || isPaintShopRole();
    }
    // مالك المستند: يُمرَّر له حقل المعرّف من المستند.
    function isOwner(uid) {
      return signedIn() && uid == request.auth.uid;
    }

    // سوبر أدمن فقط على القاعدة العامة. الأدمن المحدود عبر قواعد المجموعات أدناه.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    match /users/{uid} {
      // حقول لا يملكها المستخدم: تُدار من الإدارة أو من Cloud Functions فقط.
      function protectedFields() {
        return [
          'role',
          'verified',
          'verificationStatus',
          'walletBalance',
          'ratingAvg',
          'ratingCount',
          'adminLevel',
          'adminPermissions',
          'disabled',
          'commissionPercent',
          'commissionRate',
          'oilWorkshopTier',
        ];
      }
      function keepsProtectedFields() {
        return !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(protectedFields());
      }

      allow read: if adminCanReadUserDoc() || isUser(uid);

      // الفني يقرأ رصيد العميل عند التسوية فقط (قراءة مستند، لا قائمة).
      allow get: if isProviderRole() && resource.data.role == 'customer';

      // الأدمن (بصلاحية القسم) ينشئ حساباً؛ التطبيق ينشئ حسابه فقط وفق القيود.
      allow create: if adminCanCreateUserDoc()
        || (isUser(uid)
          && request.resource.data.walletBalance == 0
          && request.resource.data.ratingCount == 0
          && request.resource.data.get('commissionPercent', 0) == 0
          && !request.resource.data.keys().hasAny([
            'adminLevel', 'adminPermissions', 'disabled', 'commissionRate'
          ])
          && (
            (request.resource.data.role == 'customer'
              && request.resource.data.verified == true
              && request.resource.data.verificationStatus == 'approved')
            || (request.resource.data.role == 'technician'
              && request.resource.data.verified == false
              && request.resource.data.verificationStatus == 'pending')
            || (request.resource.data.role == 'workshop'
              && request.resource.data.verified == false
              && request.resource.data.verificationStatus == 'pending')
            || (request.resource.data.role == 'oilWorkshop'
              && request.resource.data.verified == false
              && request.resource.data.verificationStatus == 'pending')
            || (request.resource.data.role == 'paintShop'
              && request.resource.data.verified == false
              && request.resource.data.verificationStatus == 'pending')
          ));

      allow update: if adminCanWriteUserDoc()
        || (isUser(uid) && keepsProtectedFields())
        || (isUser(uid) && commissionDebit())
        || customerWalletSettle();

      // الفني/ورشة الزيوت يحدّث رصيد العميل فقط بمبلغ التسوية المسجّل على الطلب الذي يكمله.
      function customerWalletSettle() {
        let jobId = request.resource.data.walletJobId;
        let job = getAfter(/databases/$(database)/documents/jobs/$(jobId)).data;
        let bill = job.finalPrice is number && job.finalPrice > 0
          ? job.finalPrice
          : (job.initialPrice is number && job.initialPrice > 0
              ? job.initialPrice
              : 0);
        return (isTechnicianRole() || isOilWorkshopRole())
          && resource.data.role == 'customer'
          && jobId is string
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['walletBalance', 'walletJobId'])
          && request.resource.data.walletBalance is number
          && job.customerId == uid
          && job.technicianId == request.auth.uid
          && job.status == 'completed'
          && job.walletApplied is number
          && job.changeAmount is number
          && job.walletApplied >= 0
          && job.changeAmount >= 0
          && job.walletApplied <= bill + 0.05
          && job.receivedAmount is number
          && job.changeAmount <= job.receivedAmount + 0.05
          && request.resource.data.walletBalance
              == resource.data.walletBalance - job.walletApplied + job.changeAmount;
      }

      // الفني يخصم من محفظته فقط (لا يستطيع زيادة الرصيد). الزيادة للأدمن.
      function commissionDebit() {
        return request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['walletBalance', 'isOnline'])
          && request.resource.data.walletBalance is number
          && request.resource.data.walletBalance <= resource.data.walletBalance;
      }

      allow delete: if adminCanWriteUserDoc();
    }

    // كتالوج الخدمات يُدار من لوحة التحكم فقط، والتطبيق يقرأه.
    match /services/{id} {
      allow read: if signedIn() || adminCanRead('services');
      allow write: if adminCanWrite('services');
    }

    match /jobLocations/{jobId} {
      // العميل أو الفني المعيّن على الطلب (بعد القبول يحتاج الموقع الدقيق).
      allow read: if isOwner(resource.data.customerId)
        || adminCanRead('orders')
        || (signedIn()
          && get(/databases/$(database)/documents/jobs/$(jobId)).data.technicianId
              == request.auth.uid);
      allow update: if isOwner(resource.data.customerId) || adminCanWrite('orders');
      allow create: if isOwner(request.resource.data.customerId) || adminCanWrite('orders');
      allow delete: if adminCanWrite('orders');
    }

    match /jobs/{jobId} {
      function isCustomer() {
        return isOwner(resource.data.customerId);
      }
      function isTech() {
        return isOwner(resource.data.technicianId);
      }
      function creatingOwnJob() {
        return isOwner(request.resource.data.customerId)
          && request.resource.data.status in ['dispatching', 'offerPending'];
      }
      function isOpenForBidding() {
        return isProviderRole()
          && resource.data.status in ['dispatching', 'offerPending', 'comparing', 'noTechnician']
          && resource.data.technicianId == null;
      }
      function jobDiffKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // كل طرف يكتب تقييمه فقط؛ لا يغيّر تقييم الطرف الآخر له.
      function keepsRating(side) {
        return request.resource.data.get('ratings', {}).get(side, null)
          == resource.data.get('ratings', {}).get(side, null);
      }

      // قبول طارئ: المزود يعيّن نفسه على طلب مفتوح بحقول محدودة (مطابق لـ _winEmergencyOffer).
      function claimingOpenJob() {
        return isProviderRole()
          && resource.data.technicianId == null
          && request.resource.data.technicianId == request.auth.uid
          && resource.data.status in ['dispatching', 'offerPending', 'comparing', 'noTechnician']
          && request.resource.data.status in ['quoted', 'enRoute', 'arrived', 'inProgress', 'providerQueued']
          && jobDiffKeys().hasOnly([
            'technicianId', 'technicianName', 'initialPrice', 'status',
            'lastAssignedTechnicianId', 'cancelledBy', 'cancelReason', 'exactLocation'
          ]);
      }

      function isPartsJob() {
        return resource.data.serviceId == 'parts'
          || resource.data.providerKind == 'workshop';
      }

      function assignedOfferOk() {
        let offerId = request.resource.data.assignedOfferId;
        return offerId is string
          && get(/databases/$(database)/documents/jobOffers/$(offerId)).data.jobId == jobId
          && get(/databases/$(database)/documents/jobOffers/$(offerId)).data.technicianId
              == request.resource.data.technicianId
          && get(/databases/$(database)/documents/jobOffers/$(offerId)).data.status == 'submitted';
      }

      function customerRedispatch() {
        return isCustomer()
          && resource.data.technicianId == null
          && request.resource.data.technicianId == null
          && request.resource.data.status in ['dispatching', 'noTechnician']
          && jobDiffKeys().hasOnly(['status', 'dispatchRound', 'offerIds', 'windowSeconds', 'expiresAt']);
      }

      function customerComparing() {
        return isCustomer()
          && resource.data.technicianId == null
          && request.resource.data.technicianId == null
          && resource.data.status == 'offerPending'
          && request.resource.data.status == 'comparing'
          && jobDiffKeys().hasOnly(['status']);
      }

      function customerAssignOffer() {
        return isCustomer()
          && keepsRating('techToCustomer')
          && resource.data.technicianId == null
          && resource.data.status in ['offerPending', 'comparing']
          && request.resource.data.status in ['quoted', 'enRoute', 'providerQueued']
          && assignedOfferOk()
          && !jobDiffKeys().hasAny(['customerId', 'serviceId'])
          && jobDiffKeys().hasOnly([
            'status', 'technicianId', 'technicianName', 'lastAssignedTechnicianId',
            'cancelledBy', 'cancelReason', 'initialPrice', 'finalPrice',
            'exactLocation', 'deliveryAddress', 'partCondition', 'deliveryType',
            'vendorNote', 'warranty', 'assignedOfferId'
          ]);
      }

      function customerAcceptQuote() {
        return isCustomer()
          && resource.data.status == 'quoted'
          && request.resource.data.status in ['enRoute', 'providerQueued']
          && request.resource.data.technicianId == resource.data.technicianId
          && jobDiffKeys().hasOnly(['status', 'exactLocation']);
      }

      function customerCanCancelFrom() {
        return resource.data.status in [
          'dispatching', 'offerPending', 'comparing', 'quoted',
          'providerQueued', 'noTechnician', 'enRoute', 'arrived', 'finalQuote'
        ] || (isPartsJob() && resource.data.status == 'inProgress');
      }

      function customerCancel() {
        return isCustomer()
          && customerCanCancelFrom()
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == 'customer'
          && jobDiffKeys().hasOnly([
            'status', 'technicianId', 'technicianName',
            'lastAssignedTechnicianId', 'cancelledBy', 'cancelReason'
          ]);
      }

      function customerWallet() {
        return isCustomer()
          && jobDiffKeys().hasOnly(['useWallet', 'walletReserve']);
      }

      function customerCompleteParts() {
        return isCustomer()
          && isPartsJob()
          && resource.data.status in ['inProgress', 'arrived', 'finalQuote']
          && request.resource.data.status == 'completed'
          && request.resource.data.technicianId == resource.data.technicianId
          && jobDiffKeys().hasOnly([
            'status', 'receivedAmount', 'commissionAmount', 'commissionRate',
            'finalPrice', 'warranty'
          ]);
      }

      function customerAcceptFinal() {
        return isCustomer()
          && resource.data.status == 'finalQuote'
          && request.resource.data.status == 'inProgress'
          && jobDiffKeys().hasOnly(['status']);
      }

      function customerRate() {
        return isCustomer()
          && resource.data.status in ['completed', 'rated']
          && request.resource.data.status in ['completed', 'rated']
          && keepsRating('techToCustomer')
          && jobDiffKeys().hasOnly(['status', 'ratings']);
      }

      // أدنى سعر مسموح بعد تخفيض حتى 20% من العرض المبدئي.
      function minAllowedFromInitial() {
        return resource.data.initialPrice is number
          && resource.data.initialPrice > 0
          ? resource.data.initialPrice * 0.8
          : 0;
      }

      function priceBaseline() {
        return resource.data.finalPrice is number && resource.data.finalPrice > 0
          ? resource.data.finalPrice
          : (resource.data.initialPrice is number && resource.data.initialPrice > 0
              ? resource.data.initialPrice
              : 0);
      }

      // لا يُخفض السعر النهائي أو المبلغ المستلم أكثر من 20% عن المرجع.
      // استثناء: عند المحفظة يُسمح بالمطلوب نقداً إن كان أقل من حد 20%.
      function respectsPriceReductionCap() {
        let minFromInitial = minAllowedFromInitial();
        let baseline = priceBaseline();
        let minFromBaseline = baseline > 0 ? baseline * 0.8 : 0;
        let reserve = resource.data.useWallet == true
          && resource.data.walletReserve is number
          ? resource.data.walletReserve
          : 0;
        let cashDue = baseline - reserve;
        let cashDueClamped = cashDue < 0 ? 0 : cashDue;
        let finalOk = !jobDiffKeys().hasAny(['finalPrice'])
          || !(request.resource.data.finalPrice is number)
          || minFromInitial <= 0
          || request.resource.data.finalPrice >= minFromInitial - 0.05;
        let receivedOk = !jobDiffKeys().hasAny(['receivedAmount'])
          || !(request.resource.data.receivedAmount is number)
          || request.resource.data.receivedAmount <= 0.05
          || minFromBaseline <= 0
          || request.resource.data.receivedAmount >= minFromBaseline - 0.05
          || (resource.data.useWallet == true
            && cashDueClamped < minFromBaseline
            && request.resource.data.receivedAmount >= cashDueClamped - 0.05);
        return finalOk && receivedOk;
      }

      // الفني/الورشة المعيّنة: تقدّم الحالة والإكمال — بلا تغيير customerId/commissionRate.
      function assignedTechJobUpdate() {
        return isTech()
          && !jobDiffKeys().hasAny([
            'customerId', 'serviceId', 'commissionRate', 'useWallet', 'walletReserve'
          ])
          && respectsPriceReductionCap()
          && keepsRating('customerToTech')
          && jobDiffKeys().hasOnly([
            'status', 'finalPrice', 'warranty', 'receivedAmount', 'commissionAmount',
            'exactLocation', 'technicianId', 'technicianName', 'lastAssignedTechnicianId',
            'cancelledBy', 'cancelReason', 'walletApplied', 'changeAmount', 'ratings',
            'deliveryType', 'vendorNote', 'partCondition', 'initialPrice',
            'shippedPartImageUrl'
          ]);
      }

      allow create: if creatingOwnJob() || adminCanWrite('orders');
      allow read: if isCustomer() || isTech() || isOpenForBidding()
        || adminCanRead('orders') || adminCanRead('ratings') || adminCanRead('reports');
      allow update: if claimingOpenJob()
        || customerRedispatch()
        || customerComparing()
        || customerAssignOffer()
        || customerAcceptQuote()
        || customerCancel()
        || customerWallet()
        || customerCompleteParts()
        || customerAcceptFinal()
        || customerRate()
        || assignedTechJobUpdate()
        || adminCanWrite('orders');
      allow delete: if adminCanWrite('orders');
    }

    // قفل زيارة واحدة لكل مزوّد. يُكتب مع تعيين الطلب في نفس العملية.
    match /providerSlots/{providerId} {
      function nextJob() {
        return getAfter(/databases/$(database)/documents/jobs/$(request.resource.data.activeJobId)).data;
      }
      function slotKeysOk() {
        return request.resource.data.keys().hasOnly(['activeJobId', 'updatedAt'])
          && request.resource.data.activeJobId is string;
      }
      // العميل يقرأ القفل داخل معاملة القبول حتى لو كان الطلب النشط لعميل آخر.
      allow read: if signedIn();
      allow create, update: if slotKeysOk() && (
        (request.auth.uid == providerId && (
          request.resource.data.activeJobId.size() == 0
          || nextJob().technicianId == providerId
        ))
        || (
          request.resource.data.activeJobId.size() > 0
          && nextJob().customerId == request.auth.uid
          && nextJob().technicianId == providerId
        )
        // العميل يفرّغ القفل عند إلغاء طلبه فقط، دون قراءة طلب غيره.
        || (
          request.resource.data.activeJobId.size() == 0
          && resource != null
          && resource.data.activeJobId is string
          && resource.data.activeJobId.size() > 0
          && get(/databases/$(database)/documents/jobs/$(resource.data.activeJobId)).data.customerId
              == request.auth.uid
        )
      );
      allow delete: if adminCanWrite('orders');
    }

    match /jobOffers/{offerId} {
      function existingOfferJob() {
        return get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data;
      }
      function jobCustomerId() {
        return existingOfferJob().customerId;
      }

      allow read: if isOwner(resource.data.technicianId) || isOwner(jobCustomerId())
        || adminCanRead('orders');
      // المزود ينشئ/يملك عرضه فقط. التوزيع من السيرفر.
      allow create: if adminCanWrite('orders')
        || (signedIn()
        && request.resource.data.jobId is string
        && request.resource.data.technicianId is string
        && request.resource.data.status in ['pending', 'submitted']
        && isProviderRole()
        && isOwner(request.resource.data.technicianId));
      // الفني الفائز يغلق عروض الباقين (حالة فقط) بعد ما يُسند الطلب له.
      function winnerClosingOffer() {
        return isProviderRole()
          && resource.data.status in ['pending', 'submitted']
          && request.resource.data.status == 'expired'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && existingOfferJob().technicianId == request.auth.uid;
      }

      function keepsOfferIdentity() {
        return request.resource.data.jobId == resource.data.jobId
          && request.resource.data.technicianId == resource.data.technicianId;
      }

      allow update: if ((isOwner(resource.data.technicianId) || isOwner(jobCustomerId()))
          && keepsOfferIdentity())
        || winnerClosingOffer()
        || adminCanWrite('orders');
      allow delete: if adminCanWrite('orders');
    }

    // ---------------------------------------------------------------
    // مجموعات تُدار من لوحة التحكم. الكتابة للأدمن فقط (القاعدة العامة أعلاه)،
    // وما يلي يحدد ما يستطيع التطبيق قراءته أو إنشاءه.
    // ---------------------------------------------------------------

    // بيانات مرجعية يقرأها التطبيق: التصنيفات، السيارات، المناطق، الإعدادات.
    match /serviceCategories/{id} {
      allow read: if signedIn() || adminCanRead('services');
      allow write: if adminCanWrite('services');
    }
    match /carBrands/{id} {
      allow read: if signedIn() || adminCanRead('cars');
      allow write: if adminCanWrite('cars');
    }
    match /carModels/{id} {
      allow read: if signedIn() || adminCanRead('cars');
      allow write: if adminCanWrite('cars');
    }
    match /carYears/{id} {
      allow read: if signedIn() || adminCanRead('cars');
      allow write: if adminCanWrite('cars');
    }
    match /vehicleTypes/{id} {
      allow read: if signedIn() || adminCanRead('cars');
      allow write: if adminCanWrite('cars');
    }
    match /oilTypes/{id} {
      allow read: if signedIn() || adminCanRead('workshops');
      allow write: if adminCanWrite('workshops');
    }
    // كتالوج الاختصاصات للقوائم المنسدلة أثناء التسجيل (قبل تسجيل الدخول).
    match /workshopSpecialties/{id} {
      allow get, list: if true;
      allow write: if adminCanWrite('workshops');
    }
    match /cities/{id} {
      allow read: if signedIn() || adminCanRead('regions');
      allow write: if adminCanWrite('regions');
    }
    match /serviceAreas/{id} {
      allow read: if signedIn() || adminCanRead('regions');
      allow write: if adminCanWrite('regions');
    }
    match /appSettings/{id} {
      allow read: if signedIn() || adminCanRead('settings') || adminCanRead('dashboard');
      allow write: if adminCanWrite('settings');
    }

    // الضمان: صاحب الطلب أو الفني ينشئ ويقرأ، والإدارة تتابع.
    match /warranties/{id} {
      allow read: if isOwner(resource.data.customerId)
        || isOwner(resource.data.technicianId)
        || adminCanRead('warranties');
      allow create: if isOwner(request.resource.data.customerId)
        || isOwner(request.resource.data.technicianId)
        || adminCanWrite('warranties');
      allow update, delete: if adminCanWrite('warranties');
    }
    match /warrantyClaims/{id} {
      function claimProviderId() {
        return resource.data.keys().hasAny(['providerId'])
          && resource.data.providerId is string
          && resource.data.providerId.size() > 0
          ? resource.data.providerId
          : resource.data.technicianId;
      }
      function claimProviderIdAfter() {
        return request.resource.data.keys().hasAny(['providerId'])
          && request.resource.data.providerId is string
          && request.resource.data.providerId.size() > 0
          ? request.resource.data.providerId
          : request.resource.data.technicianId;
      }
      function isClaimCustomer() {
        return isOwner(resource.data.customerId);
      }
      function isClaimProvider() {
        return signedIn() && request.auth.uid == claimProviderId();
      }
      function providerClaimUpdateKeys() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status', 'providerNote', 'otherIssue', 'otherIssueNote',
            'replacementImageUrl', 'resolution', 'acknowledgedAt',
            'resolvedAt', 'updatedAt', 'notifyEvent'
          ]);
      }
      function validProviderStatus() {
        return request.resource.data.status in [
          'acknowledged', 'in_progress', 'resolved', 'overdue'
        ];
      }
      allow read: if isClaimCustomer()
        || isClaimProvider()
        || adminCanRead('warranties');
      allow create: if isOwner(request.resource.data.customerId)
        && request.resource.data.jobId is string
        && request.resource.data.providerId is string
        && request.resource.data.providerId.size() > 0
        && request.resource.data.status == 'open'
        && request.resource.data.providerKind in ['workshop', 'technician']
        || adminCanWrite('warranties');
      allow update: if adminCanWrite('warranties')
        || (isClaimProvider()
          && providerClaimUpdateKeys()
          && validProviderStatus()
          && claimProviderIdAfter() == claimProviderId()
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.jobId == resource.data.jobId);
      allow delete: if adminCanWrite('warranties');
    }

    // المحاسبة: كل طرف يرى حركاته فقط. الكتابة عبر Admin SDK أو صلاحية payments.
    match /transactions/{id} {
      allow read: if isOwner(resource.data.userId) || adminCanRead('payments');
      allow write: if adminCanWrite('payments');
    }
    // دفتر المحفظة: الأدمن يكتب عبر القاعدة العامة. الفني ينشئ حركة عمولة فقط
    // ضمن نفس الطلب الذي يخصم الرصيد، وبمعرّف ثابت يمنع التكرار.
    match /walletEntries/{id} {
      allow list: if isOwner(resource.data.userId) || adminCanRead('payments');
      // المعاملة تقرأ commission_{jobId} قبل إنشائها، والمستند غير موجود بعد.
      allow get: if adminCanRead('payments') || (signedIn() && (
        (!exists(/databases/$(database)/documents/walletEntries/$(id))
          && (id.matches('commission_.+')
            || id.matches('spend_.+')
            || id.matches('change_.+')))
        || isOwner(resource.data.userId)
      ));
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.type == 'commission'
        && request.resource.data.jobId is string
        && id == 'commission_' + request.resource.data.jobId
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.signedAmount == (0 - request.resource.data.amount)
        && getAfter(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.technicianId == request.auth.uid
        && getAfter(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'completed'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.walletBalance
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.walletBalance
              + request.resource.data.signedAmount;
      allow create: if isTechnicianRole()
        && request.resource.data.type in ['change', 'spend']
        && request.resource.data.jobId is string
        && request.resource.data.userId is string
        && (id == 'change_' + request.resource.data.jobId
          || id == 'spend_' + request.resource.data.jobId)
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && getAfter(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.technicianId == request.auth.uid
        && getAfter(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.customerId == request.resource.data.userId
        && getAfter(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'completed';
      allow create, update, delete: if adminCanWrite('payments');
    }
    match /payouts/{id} {
      allow read: if isOwner(resource.data.technicianId) || adminCanRead('payments');
      allow write: if adminCanWrite('payments');
    }

    // طلبات شحن المحفظة: المزود ينشئ طلباً معلّقاً مع هاتف التحويل؛ الفاتورة اختيارية.
    match /walletTopUps/{id} {
      allow read: if isOwner(resource.data.technicianId) || adminCanRead('payments');
      allow create: if isOwner(request.resource.data.technicianId)
        && isProviderRole()
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.receiptUrl is string
        && request.resource.data.transferPhone is string
        && request.resource.data.transferPhone.size() >= 10
        && request.resource.data.transferPhone.size() <= 20;
      allow update, delete: if adminCanWrite('payments');
    }

    // الدعم والنزاعات: المستخدم يفتح التذكرة ويقرأ تذاكره ويرد برسالة.
    match /supportTickets/{id} {
      function supportOwnerCreateOk() {
        return isOwner(request.resource.data.userId)
          && request.resource.data.keys().hasAll([
            'subject', 'body', 'userId', 'userRole', 'status', 'messages'
          ])
          && request.resource.data.status == 'open'
          && request.resource.data.subject is string
          && request.resource.data.body is string
          && request.resource.data.messages is list;
      }
      function supportOwnerReplyOk() {
        let prevCount = (resource.data.keys().hasAny(['messages'])
            && resource.data.messages is list)
          ? resource.data.messages.size()
          : 0;
        return isOwner(resource.data.userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userRole == resource.data.userRole
          && request.resource.data.subject == resource.data.subject
          && request.resource.data.body == resource.data.body
          && request.resource.data.status in ['open', 'closed']
          && request.resource.data.messages is list
          && request.resource.data.messages.size() >= prevCount;
      }
      allow read: if isOwner(resource.data.userId) || adminCanRead('support');
      allow create: if supportOwnerCreateOk() || adminCanWrite('support');
      allow update: if adminCanWrite('support') || supportOwnerReplyOk();
      allow delete: if adminCanWrite('support');
    }
    match /disputes/{id} {
      allow read: if isOwner(resource.data.customerId)
        || isOwner(resource.data.technicianId)
        || adminCanRead('orders')
        || adminCanRead('support');
      allow create: if isOwner(request.resource.data.customerId)
        || isOwner(request.resource.data.technicianId)
        || adminCanWrite('orders');
      allow update, delete: if adminCanWrite('orders') || adminCanWrite('support');
    }

    // الإشعارات: المستلم يقرأ ويعلّم إشعاره كمقروء.
    match /notifications/{id} {
      allow read: if isOwner(resource.data.userId) || adminCanRead('notifications');
      allow create: if adminCanWrite('notifications');
      allow update: if (isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read', 'readAt']))
        || adminCanWrite('notifications');
      allow delete: if adminCanWrite('notifications');
    }

    // فهرس الهواتف — get فقط (لا list) حتى يتحقق العميل من التفرد دون قراءة users.
    // الأدمن ذو صلاحية كتابة للمستخدمين يمكنه ربط رقم لحساب ينشئه.
    function adminCanWritePhoneRegistry() {
      return adminCanWrite('users')
        || adminCanWrite('customers')
        || adminCanWrite('technicians')
        || adminCanWrite('workshops');
    }
    match /phoneRegistry/{phoneKey} {
      allow get: if signedIn();
      allow create: if (signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.phone is string)
        || (adminCanWritePhoneRegistry()
          && request.resource.data.uid is string
          && request.resource.data.phone is string);
      allow update: if (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid)
        || (adminCanWritePhoneRegistry()
          && request.resource.data.uid is string
          && request.resource.data.phone is string);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        || adminCanWritePhoneRegistry();
      allow list: if isSuperAdmin();
    }

    // توكن FCM منفصل عن users حتى لا يُكشف لمن يقرأ ملفات المزوّدين. السيرفر يقرأ عبر Admin SDK.
    match /userTokens/{uid} {
      allow get, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string;
    }

    // جلسات OTP — Admin SDK فقط (السيرفر على VPS). حتى الأدمن لا يحتاجها من العميل.
    match /otpSessions/{id} {
      allow read, write: if false;
    }

    // مجموعات إدارية بحتة (adminLogs...) — سوبر فقط عبر القاعدة العامة.
  }
}
